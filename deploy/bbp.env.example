# /etc/bbp.env — loaded by systemd (chmod 600)
BBP_ENV=staging
BBP_DATABASE_URL=sqlite:////opt/bbp/var/bbp.sqlite3
BBP_STORAGE_DIR=/opt/bbp/var/storage
BBP_PDF_FONT=/usr/share/fonts/truetype/noto/NotoSansHebrew-Regular.ttf
BBP_PDF_FONT_BOLD=/usr/share/fonts/truetype/noto/NotoSansHebrew-Bold.ttf
BBP_CORS_ORIGINS=https://bbp.example.gov.il
BBP_ODA_CONVERTER=
BBP_OLLAMA_URL=http://127.0.0.1:11434
BBP_INTEGRATIONS_ENABLED=false
