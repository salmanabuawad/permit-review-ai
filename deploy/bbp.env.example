# /etc/bbp.env — loaded by systemd (chmod 600)
BBP_ENV=staging
BBP_DATABASE_URL=sqlite:////opt/bbp/var/bbp.sqlite3
BBP_STORAGE_DIR=/opt/bbp/var/storage
BBP_PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Font must cover Hebrew AND Latin and ≥. NotoSansHebrew has no Latin letters, so case numbers vanish from PDFs.
BBP_PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
BBP_CORS_ORIGINS=https://bbp.example.gov.il
BBP_ODA_CONVERTER=
# Language model (OpenAI-compatible). The model runs on the AI PC, reached through the LLM relay
# (deploy/bbp-llm-relay.service), as on muniflow.kortexd.com. For a model on this host instead: http://127.0.0.1:11434/v1
BBP_LLM_BASE_URL=http://127.0.0.1:18112/v1
BBP_LLM_TIMEOUT=180
# Relay token: python3 -c "import secrets; print(secrets.token_urlsafe(32))" — same value in the AI PC's agent env file
BBP_LLM_RELAY_TOKEN=
BBP_LLM_RELAY_POLL_INTERVAL=1
BBP_INTEGRATIONS_ENABLED=false
