# ~/.config/bbp-ai-agent.env on the AI PC (chmod 600)
BBP_LLM_RELAY_URL=https://bbp.example.gov.il/llm-relay
BBP_LLM_RELAY_TOKEN=<same value as BBP_LLM_RELAY_TOKEN in /etc/bbp.env>
# llama.cpp router (shared with muniflow) — or http://127.0.0.1:11434 for Ollama
BBP_LLM_RELAY_LOCAL=http://127.0.0.1:8081
BBP_LLM_RELAY_CONCURRENCY=2
# DWFX drawings are converted to PDF on this PC (agent/dwfx_convert.py, needs PyMuPDF), never on the server.
# BBP_APP_URL=https://bbp.example.gov.il          default: BBP_LLM_RELAY_URL without /llm-relay
# BBP_CONVERT_PYTHON=/path/to/python-with-pymupdf  default: the repository's .venv/bin/python
# BBP_DWFX_CONVERSION=0                            turns the converter off
